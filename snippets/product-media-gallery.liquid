<!-- Main Image Swiper -->
<div class="swiper-container swiper-main">
  <div class="swiper-wrapper">
    {% for image in product.images %}
      <div class="swiper-slide">
        <img src="{{ image.src | image_url }}" alt="Main Product Image">
      </div>
    {% endfor %}
  </div>
</div>

<!-- Thumbnail Swiper -->
<div class="swiper-container swiper-thumbs">
  <div class="swiper-wrapper">
    {% for image in product.images %}
      <div class="swiper-slide">
        <img src="{{ image.src | image_url }}" alt="Thumb {{ forloop.index }}">
      </div>
    {% endfor %}
  </div>
</div>

<!-- Progress Bar -->
<div class="progress-bar-container">
  <div class="progress-bar"></div>
</div>

<!-- Navigation Buttons -->
<div class="slider-buttons">
  <button id="prevSlide"><i class="fa fa-angle-left" style="font-size:24px"></i></button>
  <button id="nextSlide"><i class="fa fa-angle-right" style="font-size:24px"></i></button>
</div>

<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Initialize Thumbnail Swiper
    const thumbsSwiper = new Swiper('.swiper-thumbs', {
      slidesPerView: 3,
      spaceBetween: 10,
      watchSlidesVisibility: true,
      watchSlidesProgress: true,
      slideToClickedSlide: true
    });

    // Initialize Main Swiper
    const mainSwiper = new Swiper('.swiper-main', {
      slidesPerView: 1,
      loop: false,
      spaceBetween: 10,
      thumbs: {
        swiper: thumbsSwiper, // directly connect thumbs
      },
      on: {
        slideChange: updateProgressBar, // Progress bar update handled here
      }
    });

    // Progress Bar Element
    const progressBar = document.querySelector('.progress-bar');

    // Function to update the progress bar
    function updateProgressBar() {
      const totalSlides = mainSwiper.slides.length; 
      const progressPercentage = ((mainSwiper.realIndex + 1) / totalSlides) * 100;
      progressBar.style.width = `${progressPercentage}%`;
    }

    // Initial progress bar update
    updateProgressBar();

    // Navigation Buttons
    const prevButton = document.getElementById('prevSlide');
    const nextButton = document.getElementById('nextSlide');

    prevButton.addEventListener('click', function () {
      mainSwiper.slidePrev();
    });

    nextButton.addEventListener('click', function () {
      mainSwiper.slideNext();
    });
  });
</script>



