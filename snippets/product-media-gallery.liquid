<script>
  document.addEventListener("DOMContentLoaded", function () {
    const sectionId = "{{ section.id }}";
    const galleryId = `Slider-Gallery-${sectionId}`;
    const slider = document.getElementById(galleryId);

    if (!slider) return;

    const slides = slider.querySelectorAll(".slider__slide");
    const sliderComponent = slider.closest("slider-component");
    const nextBtn = sliderComponent?.querySelector(".slider-button--next");
    const prevBtn = sliderComponent?.querySelector(".slider-button--prev");
    const counterCurrent = sliderComponent?.querySelector(".slider-counter--current");
    const counterTotal = sliderComponent?.querySelector(".slider-counter--total");

    let currentIndex = 0;
    const totalSlides = slides.length;

    // Guard against undefined or zero
    if (counterTotal && !isNaN(totalSlides) && totalSlides > 0) {
      counterTotal.textContent = totalSlides;
    }

    function updateSlider(index) {
      if (index < 0 || index >= totalSlides) return;

      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === index);
      });

      slides[index].scrollIntoView({ behavior: "smooth", inline: "center" });

      if (counterCurrent && !isNaN(index)) {
        counterCurrent.textContent = index + 1;
      }
    }

    nextBtn?.addEventListener("click", function () {
      if (currentIndex < totalSlides - 1) {
        currentIndex++;
        updateSlider(currentIndex);
      }
    });

    prevBtn?.addEventListener("click", function () {
      if (currentIndex > 0) {
        currentIndex--;
        updateSlider(currentIndex);
      }
    });

    // Initialize on load
    updateSlider(currentIndex);
  });
</script>

