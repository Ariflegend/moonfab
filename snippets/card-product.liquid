      <script>
let isProcessing = false;

document.addEventListener('DOMContentLoaded', function () {
  const addToCartButtons = document.querySelectorAll('.btn-add-to-cart');

  addToCartButtons.forEach(button => {
    button.addEventListener('click', function () {
      if (isProcessing) return; // Prevent multiple clicks
      isProcessing = true; // Set flag to prevent repeated execution
      
      const variantId = this.dataset.variantId;

      if (variantId) {
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            items: [
              {
                id: variantId,
                quantity: 1, // Only 1 quantity
              },
            ],
          }),
        })
          .then(response => {
            if (response.ok) {
              setTimeout(() => {
                window.location.href = '/cart'; // Redirect after a short delay
              }, 500); // 500ms delay to allow the cart to update
            } else {
              return response.json().then(data => {
                alert(data.message || 'Failed to add to cart.');
              });
            }
          })
          .catch(error => {
            console.error('Error:', error);
          })
          .finally(() => {
            isProcessing = false; // Reset the flag after processing is done
          });
      } else {
        alert('Variant ID is missing!');
        isProcessing = false; // Reset flag if no variant ID
      }
    });
  });
});

      </script>
