{%- liquid
assign result = 'show'
# In the Shopify theme editor there is no customer session, so catalog rules
# would hide every restricted product and make their templates uneditable.
# Always show in design mode so merchants can edit product pages and cards.
unless request.design_mode
assign customer_tags = customer.tags | join: ',' | downcase | split: ','
case type
  when 'product'
    if subject == blank
      assign subject = product
    endif

    if subject.tags contains 'b2b-only'
      assign result = 'hide'
    endif

    if customer_tags contains 'b2b'
      if subject.tags contains 'b2c-only'
        assign result = 'hide'
      else
        assign result = 'show'
        if subject.variants.size > 0
          assign any_variant_visible = false
          for variant in subject.variants
            capture variant_result
              render 'sparklayer-b2b-catalogs-func', type: 'product.variant', subject: variant, customer: customer
            endcapture
            assign variant_result = variant_result | strip
            if variant_result == 'show'
              assign any_variant_visible = true
              break
            endif
          endfor
          if any_variant_visible == false
            assign result = 'hide'
          endif
        endif
      endif
    endif
  when 'product.variant'
    if customer_tags contains 'b2b'
      assign meta = subject.metafields.sparklayer.settings
      if meta != blank and meta.type == 'json'
        for item in meta.value
          assign customer_group = item.customer_group | downcase
          if customer_group
            if customer_group == 'base'
              if item.display == true
                assign result = 'show'
              elsif item.display == false
                assign result = 'hide'
              endif
            else
              assign target_tag = 'b2b' | append: '-' | append: customer_group
              if customer_tags contains target_tag
                if item.display == true
                  assign result = 'show'
                  break
                elsif item.display == false
                  assign result = 'hide'
                  break
                endif
              endif
            endif
          endif
        endfor
      endif
    endif
  when 'search.item'
    if subject and subject.object_type == 'product'
      capture result
        render 'sparklayer-b2b-catalogs-func', type: 'product', subject: subject
      endcapture
    endif
endcase
endunless

echo result
-%}