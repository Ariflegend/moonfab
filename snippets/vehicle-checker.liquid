        resultDiv.style.display = 'block';
      } else if (!data.product) {
        resultDiv.innerHTML = '<p style="color:#c0392b;font-size:13px;">Please enter a valid vehicle make and model.</p>';
        resultDiv.style.display = 'block';
      } else {
        renderResult(data, vehicle);
      }
    } catch(e) {
      resultDiv.innerHTML = '<p style="color:#c0392b;font-size:13px;">Something went wrong. Please try again.</p>';
      resultDiv.style.display = 'block';
    } finally {
      btn.textContent = 'CHECK COMPATIBILITY';
      btn.disabled = false;
    }
  }

  function renderResult(r, vehicleInput) {
    var prodKey = (r.product === 'original' && r.upsell_product === 'rv') ? 'rv' : r.product;
    var prod   = PRODUCTS[prodKey] || PRODUCTS.original;
    var badge  = BADGE[r.badge] || BADGE.this_fits;
    var upsell = r.upsell_product ? UPSELL[r.upsell_product] : null;
    var isXLorApex = r.badge === 'we_recommend';
    var needsStrut = r.needs_strut_pole === true;

    var ctaHtml;
    if (isXLorApex) {
      ctaHtml = '<a href="' + PDP[r.product] + '" class="ms-cta-btn">SHOP NOW</a>';
    } else {
      var variantId = (r.upsell_product === 'rv') ? VARIANT_IDS.rv : VARIANT_IDS.original;
      ctaHtml = '<button type="button" data-ms-main-variant-id="' + escapeAttr(String(variantId)) + '" class="ms-cta-btn">ADD TO CART</button>';
    }

    if (needsStrut) {
      var strutId = (window.__msVcStrutVariantId != null && window.__msVcStrutVariantId !== '')
        ? String(window.__msVcStrutVariantId)
        : String(VARIANT_IDS.strut_pole);
      ctaHtml += '<button type="button" data-ms-strut-variant-id="' + escapeAttr(strutId) + '" class="ms-cta-btn ms-strut-pole-btn">ADD STRUT POLE — $25</button>';
    }

    var upsellHtml = upsell
      ? '<a href="' + upsell.href + '" class="ms-upsell">' + upsell.label + '</a>'
      : '';

    var badgeStyle = 'background:' + badge.bg + ';border-color:' + (badge.border || badge.bg) + ';';

    var v = (typeof vehicleInput === 'string' ? vehicleInput : document.getElementById('ms-input').value).trim();
    var headline = (r.headline && String(r.headline).trim()) || ('Perfect Fit for your ' + v);

    var html = '<div class="ms-card">'
      + '<img src="' + prod.img + '" alt="' + escapeAttr(prod.name) + '" />'
      + '<div class="ms-card-overlay"></div>'
      + '<span class="ms-badge" style="' + badgeStyle + '">' + badge.label + '</span>'
      + '<div class="ms-card-text">'
      + '<div class="ms-product-name">' + prod.name + '</div>'
      + '<div class="ms-headline">' + escapeHtml(headline) + '</div>'
      + '</div>'
      + '</div>';

    if (r.description) {
      html += '<p>' + escapeHtml(r.description) + '</p>';
    }

    html += ctaHtml + upsellHtml;

    var resultDiv = document.getElementById('ms-result');
    resultDiv.innerHTML = html;
    resultDiv.style.display = 'block';
  }

  function escapeHtml(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }
  function escapeAttr(s) {
    return escapeHtml(s).replace(/'/g, '&#39;');
  }

  /** Drawer theme also loads <cart-notification> CSS; always prefer the active cart UI (drawer first). */
  function msGetCartUi() {
    return document.querySelector('cart-drawer') || document.querySelector('cart-notification');
  }

  function msSectionIdsFor(cart) {
    var defaults = 'cart-drawer,cart-icon-bubble';
    if (cart && typeof cart.getSectionsToRender === 'function') {
      return cart.getSectionsToRender()
        .map(function(s) { return s.id; })
        .join(',');
    }
    return defaults;
  }

  function msVcResolvePdpVariantId() {
    var v = window.__msVcPdpVariantId;
    if (v != null && v !== '') return v;
    if (typeof mainProductVariantId !== 'undefined') return mainProductVariantId;
    return null;
  }

  function msVcAnchorModalAvailable() {
    return document.getElementById('first-modal') != null && msVcResolvePdpVariantId() != null;
  }

  /** Vehicle checker ADD TO CART: open anchor modal only; MoonShade (+ optional anchor) added after user completes modal — never bundles strut. */
  function msBeginVehicleCheckerAnchorFlow() {
    var firstModal = document.getElementById('first-modal');
    if (!firstModal) return false;
    var pdpVid = msVcResolvePdpVariantId();
    if (pdpVid == null) return false;
    window.__msVehicleCheckerPendingAdd = true;
    window.__msVehicleCheckerPendingStrutOnly = false;
    window.__msVehicleCheckerPendingStrutVariantId = null;
    window.__msVehicleCheckerPendingVariantId = pdpVid;
    window.setTimeout(function () {
      firstModal.style.display = 'block';
    }, 10);
    return true;
  }

  /** ADD STRUT POLE: same anchor modal; confirm adds strut + optional anchor only (no MoonShade). */
  function msBeginVehicleCheckerStrutAnchorFlow(strutVariantId) {
    var firstModal = document.getElementById('first-modal');
    if (!firstModal) return false;
    if (strutVariantId == null || strutVariantId === '') return false;
    window.__msVehicleCheckerPendingAdd = true;
    window.__msVehicleCheckerPendingStrutOnly = true;
    window.__msVehicleCheckerPendingStrutVariantId = String(strutVariantId);
    window.__msVehicleCheckerPendingVariantId = null;
    window.setTimeout(function () {
      firstModal.style.display = 'block';
    }, 10);
    return true;
  }

  function msOpenAnchorModalFromVehicleChecker() {
    return msBeginVehicleCheckerAnchorFlow();
  }

  window.msFinalizeVehicleCheckerPendingMainOnly = function () {
    if (!window.__msVehicleCheckerPendingAdd) return;
    var strutOnly = window.__msVehicleCheckerPendingStrutOnly === true;
    var strutVid = window.__msVehicleCheckerPendingStrutVariantId;
    var vid = window.__msVehicleCheckerPendingVariantId;
    window.__msVehicleCheckerPendingAdd = false;
    window.__msVehicleCheckerPendingStrutOnly = false;
    window.__msVehicleCheckerPendingStrutVariantId = null;
    window.__msVehicleCheckerPendingVariantId = null;
    var firstModal = document.getElementById('first-modal');
    if (firstModal) firstModal.style.display = 'none';

    var lineVid = strutOnly ? strutVid : vid;
    if (lineVid == null || lineVid === '') return;

    var cart = msGetCartUi();
    var sectionIds = msSectionIdsFor(cart);
    var addUrl = (window.routes && window.routes.cart_add_url) ? window.routes.cart_add_url : '/cart/add.js';
    var idNum = parseInt(String(lineVid), 10);

    fetch(addUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Accept: 'application/json'
      },
      body: JSON.stringify({
        items: [{ id: idNum, quantity: 1 }],
        sections: sectionIds,
        sections_url: window.location.pathname
      })
    })
      .then(function (res) {
        if (!res.ok) throw new Error('add failed');
        return res.json();
      })
      .then(function (data) {
        if (data.status) {
          throw new Error(data.description || data.message || 'add failed');
        }
        msRenderCartAfterAdd(cart, data, lineVid);
      })
      .catch(function () {
        alert('Could not add to cart. Please try again.');
      });
  };

  /** Match Dawn product-form: open drawer via renderContents; never send shoppers to /cart from here. */
  function msRenderCartAfterAdd(cart, data, variantId) {
    var ui = cart || msGetCartUi();
    if (!ui) return;

    if (ui.classList && ui.classList.contains('is-empty')) {
      ui.classList.remove('is-empty');
    }

    function pub() {
      if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
        publish(PUB_SUB_EVENTS.cartUpdate, {
          source: 'ms-vehicle-checker',
          productVariantId: variantId != null ? String(variantId) : undefined,
          cartData: data
        });
      }
    }

    if (data && data.sections && typeof ui.renderContents === 'function') {
      try {
        pub();
        ui.renderContents(data);
        return;
      } catch (err) {}
    }

    pub();

    var ids = msSectionIdsFor(ui);
    fetch('/?sections=' + encodeURIComponent(ids))
      .then(function(r) {
        if (!r.ok) throw new Error('sections');
        return r.json();
      })
      .then(function(sections) {
        if (ui && typeof ui.renderContents === 'function') {
          ui.renderContents({ sections: sections });
        } else {
          var d = document.querySelector('cart-drawer');
          if (d && typeof d.open === 'function') d.open();
        }
      })
      .catch(function() {
        var d = document.querySelector('cart-drawer');
        if (d && typeof d.open === 'function') d.open();
      });
  }

  window.msAddStrutToCart = function (btn, variantId, evt) {
    if (evt) {
      if (evt.stopPropagation) evt.stopPropagation();
      if (evt.preventDefault) evt.preventDefault();
    }
    if (!variantId || btn.getAttribute('data-ms-strut-added') === '1') return;

    btn.disabled = true;
    var cart = msGetCartUi();
    var sectionIds = msSectionIdsFor(cart);
    var addUrl = (window.routes && window.routes.cart_add_url) ? window.routes.cart_add_url : '/cart/add.js';
    fetch(addUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        items: [{ id: parseInt(String(variantId), 10), quantity: 1 }],
        sections: sectionIds,
        sections_url: window.location.pathname
      })
    })
    .then(function(res) {
      if (!res.ok) throw new Error('add failed');
      return res.json();
    })
    .then(function(data) {
      if (data.status) {
        throw new Error(data.description || data.message || 'add failed');
      }
      btn.textContent = 'Added to Cart';
      btn.setAttribute('data-ms-strut-added', '1');
      btn.disabled = true;
      msRenderCartAfterAdd(cart, data, variantId);
    })
    .catch(function() {
      btn.disabled = false;
      alert('Could not add to cart. Please try again.');
    });
  };

  window.msAddToCart = function (variantId, evt) {
    if (evt) {
      if (evt.stopPropagation) evt.stopPropagation();
      if (evt.preventDefault) evt.preventDefault();
    }
    if (msVcAnchorModalAvailable() && msOpenAnchorModalFromVehicleChecker()) {
      return;
    }

    var cart = msGetCartUi();
    var sectionIds = msSectionIdsFor(cart);
    var addUrl = (window.routes && window.routes.cart_add_url) ? window.routes.cart_add_url : '/cart/add.js';

    var formData = new FormData();
    formData.append('id', String(variantId));
    formData.append('quantity', '1');
    formData.append('sections', sectionIds);
    formData.append('sections_url', window.location.pathname);

    fetch(addUrl, {
      method: 'POST',
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        Accept: 'application/json'
      },
      body: formData
    })
    .then(function(res) {
      if (!res.ok) throw new Error('add failed');
      return res.json();
    })
    .then(function(data) {
      if (data.status) {
        throw new Error(data.description || data.message || 'add failed');
      }
      msRenderCartAfterAdd(cart, data, variantId);
    })
    .catch(function() {
      alert('Could not add to cart. Please try again.');
    });
  };

  (function msVcBindResultCtas() {
    var root = document.getElementById('ms-vehicle-checker');
    if (!root) return;
    root.addEventListener(
      'click',
      function (e) {
        var strutBtn = e.target.closest('button.ms-strut-pole-btn');
        if (strutBtn) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          var sid = strutBtn.getAttribute('data-ms-strut-variant-id');
          if (sid && strutBtn.getAttribute('data-ms-strut-added') !== '1') {
            if (document.getElementById('first-modal') && msBeginVehicleCheckerStrutAnchorFlow(sid)) {
              return;
            }
            window.msAddStrutToCart(strutBtn, sid, e);
          }
          return;
        }
        var mainBtn = e.target.closest('button.ms-cta-btn:not(.ms-strut-pole-btn)');
        if (mainBtn) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          var mid = mainBtn.getAttribute('data-ms-main-variant-id');
          if (mid) {
            window.msAddToCart(mid, e);
          }
        }
      },
      true
    );
  })();

})();
</script>
