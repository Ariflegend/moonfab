          "disabled": true,
          "settings": {
            "custom_liquid": "<form action=\"/cart/add\" method=\"post\" enctype=\"multipart/form-data\" id=\"add-to-cart-form\">\n    <!-- Hidden input for the product variant ID -->\n    <input type=\"hidden\" name=\"id\" id=\"variant-id\" value=\"{{ product.variants.first.id }}\">\n    <input type=\"hidden\" name=\"quantity\" id=\"c_quantity\" value=\"1\">\n    \n    <!-- Add to Cart button -->\n    <button type=\"submit\" class=\"button btn btn--add-to-cart\">\n        Add to Cart \n    </button>\n\t<div class=\"check-edit\">\n\t\t<a href=\"/checkout\" id=\"c_check\">Checkout</a>\n\t\t<a href=\"#\" id=\"c_edit\">Edit</a>\n\t</div>\n</form>\n\n<script src=\"https://code.jquery.com/jquery-3.7.1.js\" integrity=\"sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=\" crossorigin=\"anonymous\"></script>\n\n<script>\n\njQuery(document).ready(function($){\n\n\tfunction checkVariantRefresh(selected_variant){\n\t\t//default cart button status\n\t\tfetch('/cart.js')\n\t\t  .then(response => response.json())\n\t\t  .then(cart => {\n\t\t\tconst variantIds = cart.items.map(item => item.variant_id);\n\t\t\t\tif(variantIds.length == 0){\n\t\t\t\t\t$(\".check-edit\").hide();\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tfor (let i = 0; i < variantIds.length; i++) {\n\t\t\t\t  if (variantIds[i] == selected_variant) {\n\t\t\t\t\t// hide checkout and quantity and show checkout and edit\n\t\t\t\t\t$(\".btn--add-to-cart, .product-form__quantity\").hide();\n\t\t\t\t\t$(\".check-edit\").show();\n\t\t\t\t\tbreak;\n\t\t\t\t  }else{\n\t\t\t\t\t$(\".btn--add-to-cart, .product-form__quantity\").show();\n\t\t\t\t\t$(\".check-edit\").hide();\n\t\t\t\t  }\n\t\t\t\t}\n\t\t\t\n\t\t\tconsole.log('Variant IDs in cart:', variantIds);\n\t\t\t//alert(variantIds);\n\t\t  })\n\t\t  .catch(error => console.error('Error fetching cart:', error));\n\t}\n\t\n\tfunction updateVariantId() {\n        const selectedRadio = document.querySelector('input[type=\"radio\"][name^=\"Denominations\"]:checked');\n        const variantInput = document.querySelector('#variant-id');\n\t\t\n\t\t$(\".btn--add-to-cart\").addClass(\"disabled\");\n\t\tsetTimeout(function(){\n\t\t\tconst selected_variant = document.querySelector(\"form.installment input[name='id']\").value;\n\t\t\t\n\t\t\tif (selectedRadio && variantInput) {\n\t\t\t\tvariantInput.value = selected_variant;\n\t\t\t\t\n\t\t\t}\n\t\t\t$(\".btn--add-to-cart\").removeClass(\"disabled\");\n\t\t\t\n\t\t\tcheckVariantRefresh(selected_variant);\n\t\t  \n\t\t  \n\t\t}, 2000);\n\t\t\n\t\t\n\n\t\t\n    }\n\n    // Initial update on page load\n    updateVariantId();\n\n    // Listen for changes on all radio buttons\n    document.addEventListener(\"change\", function (event) {\n        if (event.target.matches('input[type=\"radio\"][name^=\"Denominations\"]')) {\n            updateVariantId();\n        }\n    });\n\t\n\t$(\"input#Quantity-template--16793104941145__main\").on(\"change\", function(){\n\t\t$(\"#c_quantity\").val($(this).val());\n\t});\n\t\n\tdocument.getElementById('variant-id').value = getUrlParameter('variant');\n\t\n\t// Function to get URL parameters\n\tfunction getUrlParameter(name) {\n\t\tconst params = new URLSearchParams(window.location.search);\n\t\treturn params.get(name);\n\t}\n\t\n\t\n\t// Add to cart code\n\t\n\tdocument.querySelectorAll(\"#add-to-cart-form\").forEach(function (form) {\n\t\tform.addEventListener(\"submit\", function (event) {\n\t\t  event.preventDefault(); // Default form submission ko rokna\n\n\t\t  let formData = new FormData(this);\n\t\t  console.log(\"variant id : \"+document.getElementById(\"variant-id\").value);\n\t\t  let loader = form.querySelector(\".cart-loader\"); // Fix: Loader specific form ke andar dikhana\n\n\t\t  if (loader) loader.style.display = \"block\"; // Loader show karein\n\n\t\t  fetch(\"/cart/add.js\", {\n\t\t\tmethod: \"POST\",\n\t\t\tbody: formData\n\t\t  })\n\t\t  .then(response => response.json())\n\t\t  .then(data => {\n\t\t\tconsole.log(\"Product added:\", data);\n\t\t\t\n\t\t\tcheckVariantRefresh(data.id);\n\n\t\t\treturn fetch(\"/?section_id=cart-drawer\").then(response => response.text());\n\t\t  })\n\t\t  .then(html => {\n\t\t\tconst parser = new DOMParser();\n\t\t\tconst doc = parser.parseFromString(html, \"text/html\");\n\n\t\t\tconst newCartDrawerContent = document.querySelector(\"cart-drawer\").innerHTML;\n\t\t\tconst cartDrawer = document.querySelector(\"cart-drawer\");\n\n\t\t\tif (cartDrawer) {\n\t\t\t  cartDrawer.innerHTML = newCartDrawerContent;\n\t\t\t  cartDrawer.classList.add(\"active\");\n\n\t\t\t  if (cartDrawer.classList.contains(\"is-empty\")) {\n\t\t\t\tcartDrawer.classList.remove(\"is-empty\");\n\t\t\t  }\n\n\t\t\t  reinitializeCartDrawerScripts();\n\t\t\t}\n\n\t\t\tconst cartCount = document.querySelector(\".cart-count-bubble .cart-count\");\n\t\t\tif (cartCount) {\n\t\t\t  const itemCountMatch = html.match(/\"item_count\":(\\d+)/);\n\t\t\t  if (itemCountMatch) {\n\t\t\t\tconst itemCount = parseInt(itemCountMatch[1], 10);\n\t\t\t\tcartCount.textContent = itemCount;\n\t\t\t  }\n\t\t\t}\n\t\t  })\n\t\t  .catch(error => console.error(\"Error adding to cart:\", error))\n\t\t  .finally(() => {\n\t\t\tif (loader) loader.style.display = \"none\"; // Loader hide karein\n\t\t  });\n\t\t});\n\t  });\n\t  \n\t  \n\t  \n\t  $(\"#c_edit\").on(\"click\", function(e){\n\t  e.preventDefault();\n\t\t\tconst newCartDrawerContent = document.querySelector(\"cart-drawer\").innerHTML;\n\t\t\tconst cartDrawer = document.querySelector(\"cart-drawer\");\n\n\t\t\tif (cartDrawer) {\n\t\t\t  cartDrawer.innerHTML = newCartDrawerContent;\n\t\t\t  cartDrawer.classList.add(\"active\");\n\n\t\t\t  if (cartDrawer.classList.contains(\"is-empty\")) {\n\t\t\t\tcartDrawer.classList.remove(\"is-empty\");\n\t\t\t  }\n\n\t\t\t  reinitializeCartDrawerScripts();\n\t\t\t}\n\t  });\n\t  \n\t  \n\t  \n});\n    \n</script>"
