    "collapsible_content_t4PhBa": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_P6KJFX": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Where is MoonShade designed?",
            "icon": "none",
            "row_content": "<p>MoonShade was dreamed and designed by Matthew Pearson in San Francisco, California. Together with co-founder Henry Proegler, Moon is committed to creating products that are simple, elegant, and versatile.</p>",
            "page": ""
          }
        },
        "collapsible_row_q9XwJy": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Where is MoonShade manufactured?",
            "icon": "none",
            "row_content": "<p>MoonShade is manufactured in China. We have chosen some of the best tent-making manufacturers in the world, sourcing and assembling our product in Shenzhen, Guangdong Province.</p>",
            "page": ""
          }
        },
        "collapsible_row_p6yz9P": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How can I provide product feedback?",
            "icon": "none",
            "row_content": "<p>We’d love to hear from you. Use the following links to ask a question or give feedback on your experience with MoonShade.</p><p>- <a href=\"https://moonfab.co/order-support/\">Order/Sales Support</a></p><p>- <a href=\"https://moonfab.co/product-support/\">Product Support</a></p><p>- <a href=\"https://moonfab.co/leave-a-review/\">Leave a Review</a></p>",
            "page": ""
          }
        }
      },
