          "type": "column",
          "settings": {
            "image": "shopify://shop_images/247-F68A6587_jpg_2548c027-6d0c-44e1-9ac5-958ebdf79fb1.png",
            "videoupload": "",
            "title": "pack light, travel anywhere",
            "text": "<p>The full MoonShade Pro System packs into a duffel the size of a small carry-on. It weighs only 32 lbs with all three walls included. Each component comes with its own storage bag to stay organized on the go.</p>",
            "link_label": "",
            "link": ""
          }
        }
