    "collapsible_content_FQDwUH": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_wdYWRb": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I become a Moon Vehicle Expert?",
            "icon": "none",
            "row_content": "<p>Start by signing up here, and we’ll reach out to schedule a meeting. If your application is approved, we’ll onboard you, send you Moon gear, and get you started on creating content.</p>",
            "page": ""
          }
        },
        "collapsible_row_xcQPRk": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What does an MVE do?",
            "icon": "none",
            "row_content": "<p>As an MVE, you become a trusted guide for all things Moon. You’ll be featured on our website, emails, social media, and ads—helping to connect and grow the Moon community while repping our brand.</p>",
            "page": ""
          }
        },
        "collapsible_row_YPPpnA": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What are the perks of being a MVE?",
            "icon": "none",
            "row_content": "<p>You'll get exclusive access to MoonLanding events, where you can meet other MVEs and be part of our real-life community. Plus, we’ll hook you up with Moon gear to represent the brand, along with special discount codes for you and your followers.</p>",
            "page": ""
          }
        },
        "collapsible_row_zxdadT": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does it take MoonShade to ship?",
            "icon": "none",
            "row_content": "<p>Not at all! While a following helps, quality content matters most. We want to share your content and show real, authentic experiences using MoonShade. No influencer status required.</p>",
            "page": ""
          }
        },
        "collapsible_row_iJhQWN": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What do I need to become a MVE?",
            "icon": "none",
            "row_content": "<p>Just a vehicle that fits a MoonShade, that’s it! Whether it’s a van, truck, SUV, or something unique, we love seeing how different setups make the most of Moon.</p>",
            "page": ""
          }
        }
      },
