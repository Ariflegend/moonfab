    "multicolumn_rCVCXX": {
      "type": "multicolumn",
      "blocks": {
        "column_yK9PeX": {
          "type": "column",
          "settings": {
            "videoupload": "",
            "title": "<strong>Adaptable & Customizable</strong>",
            "text": "<p>The MoonSurface straps and bumpers allow you to mount it on virtually any vehicle, whether a totally flat Box Truck or a curved SUV. Once mounted, the versatile MOLLE grid panel enables you to strap in utensils, tools, and whatever else you need.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_8Jp4YY": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/EASY_SETUP_1.jpg",
            "videoupload": "",
            "title": "1. Attach the MoonMounts",
            "text": "<p>Stick your MoonMount vacuum anchors to a clean, smooth surface on your rig.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_k7QA9p": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/STEEL_STAKES.jpg",
            "videoupload": "",
            "title": "2. Adjust the straps & bumpers",
            "text": "<p>Hook the surface to the anchors, pull the straps tight, and twist the bumpers until snug.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_8FtNip": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/WEATHERPROOF.png",
