    "multicolumn_gXCawc": {
      "type": "multicolumn",
      "blocks": {
        "column_6eJfVr": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/MGRdeesYjlXFy1iQAEFqL8NZ9Vi6w2kzPtomAzHB_jpg_acafc90b-a025-485b-bc7b-d369a01c5a85.jpg",
            "videoupload": "",
            "title": "A strong workspace anywhere",
            "text": "<p>After testing multiple sizes and gauges of aluminum and steel, we landed on a <strong>36-inch, 0.09 aluminum</strong>, C-channel reinforced MoonSurface that is strong enough to handle anything you throw at it while still being lightweight, packable, and waterproof.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_kRcpnK": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Background_6.png",
            "videoupload": "",
            "title": "Vacuum-Mounted & Versatile",
            "text": "<p>Legs are overrated. The MoonSurface is held up by two incredibly strong 4.5-inch round MoonMounts that easily hold 100lbs and give you the flexibility to mount your surface whenever and wherever you want.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_zw9bnz": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/MoonSurface_Lightweight_1.jpg",
            "videoupload": "",
            "title": "Lightweight & Packable",
            "text": "<p>The Surface folds down to 2” and weighs X lbs. Making dinner at your neighbor's campsite? Bring the MoonSurface with you!</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "column_6eJfVr",
        "column_kRcpnK",
        "column_zw9bnz"
      ],
