const interval = setInterval(() => {
  const container = document.querySelector(".rebuy-quick-view__product-section");

  if (container && !container.querySelector(".custom-action-btn")) {
    const button = document.createElement("button");
    button.textContent = "Build your ShadeKit";
    button.className = "custom-action-btn button find-your";
    button.setAttribute("data-bs-toggle", "modal");
    button.setAttribute("href", "#setup-quiz");
    button.setAttribute("data-convert-linking-binding", "done");
    


    button.addEventListener("click", () => {
     
    });

    container.prepend(button);
    console.log("Custom button injected!");
  }
}, 500);

      // Page load hone ke baad button inject karo

window.addEventListener('load', function () {
  const watchForSearchInput = new MutationObserver((mutations, observer) => {
    const input = document.querySelector('.rebuy-quick-view__search-input');
  

    if (input) {
      input.addEventListener('keyup', () => {
        setTimeout(() => {
          const resultObserver = new MutationObserver((mutationList, resultObs) => {
            const noResultP = document.querySelector(".rebuy-quick-view__no-results p");
             const buttonBuild = document.querySelector(".custom-action-btn");
            console.log("buttonBuild",buttonBuild)
            if (buttonBuild) {
    buttonBuild.style.display = "inline-block";
    console.log("buttonBuild found:", buttonBuild);
  } 
           
            // alert("buttonBuild",buttonBuild)
         
            if (noResultP) {
              const span = noResultP.querySelector("span");
              if (span) {
                const keyword = span.textContent;
                noResultP.innerHTML = `Whoopsie daisy, no “${keyword}” found`;
               

                // 👇 Yahan button insert karenge
                const button = document.createElement("button");
                button.textContent = "Request This Product";
                button.style.marginTop = "10px";
                button.style.padding = "8px 16px";
                button.style.backgroundColor = "#000";
                button.style.color = "#fff";
                button.style.border = "none";
                button.style.borderRadius = "4px";
                button.style.cursor = "pointer";

                // Optional: button par event listener bhi laga sakte ho
                button.addEventListener("click", function () {
                  alert(`You requested: ${keyword}`);
                });

                // Button ko parent div ya p ke baad insert karo
            

                resultObs.disconnect();
              }
            }
          });

          resultObserver.observe(document.body, {
            childList: true,
            subtree: true,
          });
        }, 300);
      });

      observer.disconnect();
    }
  });

  watchForSearchInput.observe(document.body, {
    childList: true,
    subtree: true,
  });
});

    </script>

<!-- for target blank menu link -->
    
    <script>
  document.addEventListener("DOMContentLoaded", function () {
    const menuLinks = document.querySelectorAll('a');

    menuLinks.forEach(function(link) {
      // Check if the menu item text matches
      if (link.textContent.trim() === "Education Center") {
        link.setAttribute("target", "_blank");
      }
    });
  });




</script>

    
    
