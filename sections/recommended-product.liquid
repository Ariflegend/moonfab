    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Select Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Select Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Select Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Select Product 4"
    }
  ],
  "presets": [
