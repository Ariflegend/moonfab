}
  .recommended-products-grid {
    display: flex;
    gap: 10px !important;
    flex-wrap: wrap;
    height: 100% !important;
}
.recommended-products .product-card {
    display: block !important;
    width: 49% !important;
}
  .recommended-products  h3 {
    margin-top: 10px;
    box-shadow: unset;
    border: none !important;
    font-family: 'Poligon_Bold';
    font-size: 20.8px;
