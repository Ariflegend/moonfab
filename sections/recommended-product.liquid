{% if section.settings.product_1 != blank and section.settings.product_2 != blank and section.settings.product_3 != blank and section.settings.product_4 != blank %}
  <div class="recommended-products">
    <h2>{{ section.settings.heading }}</h2>
    <div class="recommended-products-grid">
      {% for product in (1..4) %}
  {% assign product_key = "product_" | append: product %}
  {% assign current_product = section.settings[product_key] %}

  <div class="product-card">
    <a href="{{ current_product.url }}">
      <img src="{{ current_product.featured_image | image_url  }}" alt="{{ current_product.title }}">
      <h3>{{ current_product.title }}</h3>
    </a>
   

      <div class="pricesec_comp">
    					<p class="custom-price-pro">
                           <span>{{ current_product.price | money }}</span>
                                                             <div style='{{ jm_style }}' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'>
        {{ product.metafields.judgeme.badge }}
    </div>
                        </p>
                     </div>
   
<p>{{ current_product.metafields.descriptors.summary }}</p>


  <div class="view-add">
    <a href="{{ current_product.url }}" class="view-btn">View</a>
   <form method="post" action="/cart/add" class="add-to-cart-form">
  <input type="hidden" name="id" value="{{ current_product.variants.first.id }}">
  <button type="submit" class="add-btn">Add</button>
     <div class="cart-loader"></div>
</form>
  </div>
  </div>
{% endfor %}

    </div>
  </div>

{% endif %}

<style>

  .cart-loader {
  display: none;
  position: absolute;
  right: -30px; /* Adjust based on spacing */
  top: 50%;
  transform: translateY(-50%);
  width: 20px;
  height: 20px;
  border: 3px solid #f3f3f3;
  border-top: 3px solid #3498db;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}

  .recommended-products-grid {
    display: flex;
    gap: 10px !important;
    flex-wrap: wrap;
    height: 562px;
}
  /* .view-add {
    position: absolute;
    bottom: 20px;
    width: 89%;
} */
 .recommended-products .product-card {
    display: flex !important;
    width: 24% !important;
    flex-direction: column;
    align-items: baseline;
}
  .recommended-products img {
    width: 100% !important;
    height: 262px;
    object-fit: cover;
}
.view-add {
    width: 100%;
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.recommended-products a.view-btn {
    text-transform: uppercase;
    font-family: 'Poligon_Bold';
    background-color: transparent;
    color: #3B4752;
    border: 2px solid #3B4752;
    border-radius: 60px;
    width: 48%;
    height: 41px;
    line-height: normal;
}
form.add-to-cart-form {
    position: relative;
    width: 48%;
}
  .cart-loader {
    right: 40px;
    position: absolute;
    top: 30px;
}
.recommended-products button.add-btn {
    text-transform: uppercase;
    font-family: 'Poligon_Bold';
    background-color: transparent;
    color: #fff;
    width: 100%;
    background-color: #3B4752;
    border-radius: 60px;
    height: 41px;
    border: none !important;
}
  .recommended-products {
    padding: 20px;
  }
   .recommended-products  h3 {
      margin-top: 0;
      box-shadow: unset;
      border: none !important;
      font-family: 'Poligon_Bold';
      font-size: 21.94px;
      text-align: left;
      text-decoration: none !important;
      margin-bottom: 0;
  }
   .recommended-products p {
    color: #3B4752;
    text-align: left;
    margin-top: -10px;
}
  .recommended-products h2 {
      font-family: Berringer_Rough!important;
      font-size: 24px;
  }
  .product-card {
    box-shadow: 1px 1px 2px 1px #0000001A;
    /* border: 1px solid #ddd; */
    padding: 15px;
    text-align: center;
    border-radius: 6px;
}
  .add-btn, .view-btn {
    display: block;
    margin-top: 10px;
    padding: 8px;
    background: #000;
    color: #fff;
    text-decoration: none;
  }

  @media (min-width: 989px) {
      .recommended-products  h3 {
      margin-bottom: 20px;
  }
  }
  
@media (max-width: 989px) {
.recommended-products .product-card {
