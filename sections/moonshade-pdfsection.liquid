{% schema %}
{
  "name": "PDF Section",
  "settings": [
    {
      "type": "header",
      "content": "Add PDF Documents"
    },
    {
      "type": "paragraph",
      "content": "Use this section to upload multiple PDFs dynamically."
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Instruction Manuals"
    }
  ],
  "blocks": [
    {
      "type": "pdf",
      "name": "PDF Document",
      "settings": [
        {
          "type": "image_picker",
          "id": "pdf_image",
          "label": "PDF Preview Image"
        },
        {
          "type": "text",
          "id": "pdf_title",
          "label": "PDF Title",
          "default": "New PDF Document"
        },
        {
          "type": "text",
          "id": "pdf_link",
          "label": "PDF File"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDF Section",
      "category": "Custom",
      "blocks": [
        {
          "type": "pdf"
        }
      ]
    }
  ]
}
{% endschema %}

<div class="container pdf-section page-width">
  <h2 class="text-center">{{ section.settings.section_title }}</h2>
  
  <div class="row pdf-sec"> <!-- Row should be outside the loop -->
    {% for block in section.blocks %}
      {% assign pdf_title = block.settings.pdf_title %}
      {% assign pdf_link = block.settings.pdf_link %}
      {% assign pdf_image = block.settings.pdf_image %}

      {% if pdf_link != blank %}
        <div class="col-md-6 col-xl-3 text-center">
          <h3>{{ pdf_title }}</h3>
          <figure class="wp-block-image size-large border w-100">
            <a href="{{ pdf_link }}" target="_blank">
              {% if pdf_image != blank %}
                <img src="{{ pdf_image | img_url: '400x' }}" class="img-fluid" loading="lazy">
              {% else %}
                <img src="https://via.placeholder.com/400x300?text=PDF+Preview" class="img-fluid" loading="lazy">
              {% endif %}
            </a>
          </figure>
          <div>
            <a href="{{ pdf_link }}" class="button download-btn">DOWNLOAD PDF</a>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div> <!-- Close row after loop -->
</div>

