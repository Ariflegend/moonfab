{% comment %}
  Image Feature Section
  - Single image
  - Image position toggle (left / right)
  - Grid changes automatically (2fr / 1fr)
  - Bullet points as blocks
{% endcomment %}

<section class="image-feature image-feature--{{ section.settings.image_position }}" style="background: {{ section.settings.bg_color }};">

      {% if section.settings.text != blank %}
        <div class="page-width image-feature__text">{{ section.settings.text }}</div>
      {% endif %}

  <div class="page-width image-feature__container">

    {% if section.settings.image != blank %}
      <div class="image-feature__image">
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
        >
      </div>
    {% endif %}

    <div class="image-feature__content">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}


      {% if section.blocks.size > 0 %}
        <ul class="image-feature__list">
          {% for block in section.blocks %}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="image-feature__button">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

  </div>
</section>

<style>
.image-feature {
  padding: 30px 20px;
}

.image-feature__container {
  display: grid;
  gap: 60px;
  align-items: center;
}

/* Image LEFT → image 2fr / content 1fr */
.image-feature--left .image-feature__container {
  grid-template-columns: 2fr 1fr;
}

/* Image RIGHT → content 1fr / image 2fr */
.image-feature--right .image-feature__container {
  grid-template-columns: 1fr 2fr;
}

.image-feature--right .image-feature__image {
  order: 2;
}

.image-feature__content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
}

.image-feature__image img {
  width: 100%;
  border-radius: 6px;
}

.image-feature__content h2 {
  font-size: 23.8px;
  font-family: Berringer_Rough !important;
  line-height: 27.6px;
  margin: 0;
}

.image-feature__text {
    font-size: 16px;
    margin-bottom: 30px !important;
    text-align: center;
    color: #3B4752 !important;
    font-family: Berringer_Rough !important;
    font-size: 24px !important;
    line-height: 31px;
}

.image-feature__list {
  padding-left: 18px;
margin:0px;
}

.image-feature__list li {
  margin-bottom: 8px;
  font-family: 'Poligon_Semi_Bold';
  font-size: 16px;
  line-height: 19px;
  color: #3B4752;
}

.image-feature__button {
  display: inline-block;
  padding: 14px 26px;
  background: #3e444b;
  color: #fff;
  text-decoration: none;
  border-radius: 36px;
  font-size: 14.5px;
  line-height: 24px;
  text-transform: uppercase;
  font-family: 'HelveticaNeueMedium';
  letter-spacing: 2px;
}

@media (max-width: 900px) {
  .image-feature__container {
    grid-template-columns: 1fr !important;
    gap: 8px;
  }

  .image-feature__image {
    order: 0 !important;
  }

  .image-feature__content h2 {
  font-size: 21px;
  font-family: Berringer_Rough !important;
  line-height: 26.6px;
  margin: 0;
}
a.image-feature__button {
    font-size: 12px;
    padding: 17px 26px;
    width: 80%;
    text-align: center;
    line-height: 1.2;
}
.image-feature {
  padding: 20px 20px;
}
}
</style>

{% schema %}
{
  "name": "Image Feature Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Large Suction Cup Anchors"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Check it out"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Bullet text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Feature",
      "blocks": [
        { "type": "bullet" },
        { "type": "bullet" },
        { "type": "bullet" }
      ]
    }
  ]
}
{% endschema %}
