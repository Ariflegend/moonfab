<!-- Item slider-->
<div class="ban-top">
<div class="container-fluid">
  <div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12">

      <div class="top-">

        <div class="firt"><h1>{{ section.settings.shop }}</h1></div>

        <div id="slider-control">
          
          <a class="left carousel-control previous round" href="#itemslider" data-slide="prev">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none" viewBox="0 0 24 24">
                  <path d="M15 19l-7-7 7-7" stroke="#858585" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
          </a>
          <a class="right carousel-control next round" href="#itemslider" data-slide="next">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none" viewBox="0 0 24 24">
                  <path d="M9 5l7 7-7 7" stroke="#858585" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
          </a>
        </div>

          
        <!-- <div id="slider-control">
          <a class="left carousel-control previous round" href="#itemslider" data-slide="prev">&#8249;</a>
          <a class="right carousel-control next round" href="#itemslider" data-slide="next">&#8250;</a>
        </div> -->
        
      </div>
      
      <div class="carousel carousel-showmanymoveone slide" id="itemslider" style="margin-top: 10px;">
        <div class="carousel-inner">
          {% for block in section.blocks %}
            {% assign collection = collections[block.settings.selected_collection_1] %}
            {% if collection %}
              <div class="item {% if forloop.first %}active{% endif %}">
                <div class="col-xs-12 col-sm-6 col-md-2">
                  <a href="{{ collection.url }}">
                    <img src="{{ collection.image | img_url: 'medium' }}" alt="{{ collection.title }}" class="img-responsive center-block">
                  </a>
                  <h4 class="text-center">{{ collection.title }}</h4>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="shop-all">
         <a href="{{ section.settings.shop_link }}" class="shop-new-button">{{ section.settings.shop_btn }}</a>
        </div>
      </div>
    </div>
  </div>
</div>
</div>
<style>





  
div#slider-control svg {
    padding: 8px;
    width: 45px;
    border: 1px solid #858585;
    border-radius: 50px;
    height: 45px;
}
a.left.carousel-control.previous.round {
    color: transparent;
    border: none;
    width: 40px;
    height: 40px;
    background: url('path-to-your-left-arrow.svg') no-repeat center center;
    background-size: contain;
    border-radius: 50%;
}

a.right.carousel-control.next.round {
    color: transparent;
    border: none;
    width: 40px;
    height: 40px;
    background: url('path-to-your-right-arrow.svg') no-repeat center center;
    background-size: contain;
    border-radius: 50%;
}

.shop-all {
    margin-top: 50px;
    width: 100%;
    text-align: center;
}
div#slider-control, .firt {
    width: 50%;
}
a.shop-new-button {
    color: #fff;
    background-color: #3B4752;
    padding: 15px 45px;
    border-radius: 50px;
    display: inline-block;
}
.firt h1 {
    font-family: Berringer_Rough;
    font-size: 26px;
}
.top- {
    width: 100%;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.top-title {
    display: flex;
    align-items: center;
}
a.left.carousel-control.previous.round {
    color: #858585;
    border: 1px solid #858585;
    width: 15px !IMPORTANT;
    padding: 5px 0px;
    background: #ffffff ! IMPORTANT;
    height: 40px !important;
    border-radius: 35px;
} 
a.right.carousel-control.next.round {
    color: #858585;
    border: 1px solid #858585;
    width: 15px !IMPORTANT;
    padding: 5px 12px;
    background: #ffffff ! IMPORTANT;
    height: 40px !important;
    border-radius: 35px;
}  
.ban-top {
    padding-top: 20px;
    padding-bottom: 50px;
}
.center-block {
    /* width: 280px !important; */
    border-radius: 20px !important;
    height: 300px !important;
    display: block;
    margin-right: auto;
    margin-left: auto;
    object-fit: cover !important;
}
.carousel-inner h4.text-center {
    text-transform: uppercase;
    font-family: 'Poligon_Extra_Bold';
    color: #37414B;
    font-size: 20px;
    text-decoration: underline;
