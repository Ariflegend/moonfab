<section class="custom-section-product-image">
  <div class="container image-section">
    <div class="image-block">
   <img src="{{ section.settings.image | file_url }}" class="custom-image" alt="Custom Image">


    </div>
  <div class="link-block">
  {% if section.settings.link_text %}
    <a href="{{ section.settings.link_url }}">{{ section.settings.link_text }}</a>
  {% endif %}

  {% if section.settings.link_text2 %}
    <a href="{{ section.settings.link_url2 }}">{{ section.settings.link_text2 }}</a>
  {% endif %}

  {% if section.settings.link_text3 %}
    <a href="{{ section.settings.link_url3 }}">{{ section.settings.link_text3 }}</a>
  {% endif %}

  {% if section.settings.link_text4  %}
    <a href="{{ section.settings.link_url4 }}" >{{ section.settings.link_text4 }}</a>
  {% endif %}

  {% if section.settings.link_text5  %}
    <a href="{{ section.settings.link_url5 }}" >{{ section.settings.link_text5 }}</a>
  {% endif %}

  {% if section.settings.link_text6 %}
    <a href="{{ section.settings.link_url6 }}" >{{ section.settings.link_text6 }}</a>
  {% endif %}
</div>

  </div>
</section>


<script>
document.addEventListener("DOMContentLoaded", function () {
  const images = document.querySelectorAll(".image-block img");

  images.forEach((img) => {
    let src = img.getAttribute("src");
    // Ensure double "files/" is replaced with a single "files/"
    let updatedSrc = src.replace(/files\/files\//, "files/");
    img.setAttribute("src", updatedSrc);
  });
});

</script>


