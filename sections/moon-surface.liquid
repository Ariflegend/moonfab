{% schema %}
{
  "name": "Moon Surface Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE MOONSURFACE"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A strong, adaptable table that packs down small."
    },
    {
      "type": "textarea",
      "id": "caption",
      "label": "Caption",
      "default": "Legs are overrated; ditch the wobble and finding perfectly level ground..."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SECURE EARLY BIRD OFFER"
    },
    {
      "type": "text",
      "id": "button_note",
      "label": "Button Note",
      "default": "*Limited-Time Offer"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (YouTube/Vimeo link)",
      "default": "https://www.youtube.com/embed/VIDEO_ID",
      "info": "Leave blank if you want to use custom embed instead."
    },
    {
      "type": "textarea",
      "id": "video_embed",
      "label": "Custom Video Embed",
      "info": "Paste iframe embed code here (YouTube, Vimeo, Loom, etc). This will override the Video URL."
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid",
      "default": "<p>Add custom Liquid/HTML code here</p>"
    }
  ],
  "presets": [
    {
      "name": "Moon Surface Section"
    }
  ]
}
{% endschema %}

<section class="moon-surface-section">
  <div class="page-width grid grid--2-col">
    <!-- Left Side -->
    <div class="moon-surface-left">
      <h2>{{ section.settings.heading }}</h2>
      <p class="subheading">{{ section.settings.subheading }}</p>
      <div class="caption">{{ section.settings.caption }}</div>
      
      <!-- Newsletter Form -->
      {% comment %} <form method="post" action="/contact#ContactFooter" accept-charset="UTF-8" class="newsletter-form">
        <input type="hidden" name="form_type" value="customer" />
        <input type="hidden" name="utf8" value="✓" />
        <input type="email" name="contact[email]" placeholder="Your email" required />
        <button type="submit">{{ section.settings.button_text }}</button>
      </form> {% endcomment %}

      <p class="button-note">{{ section.settings.button_note }}</p>
      
      <!-- Custom Liquid Box -->
      <div class="custom-liquid">
        {{ section.settings.custom_liquid }}
      </div>
    </div>

    <!-- Right Side -->
   <div class="moon-surface-right">
  <div class="video-wrapper custom-video">
    {% assign fixed_url = section.settings.video_url | replace: "watch?v=", "embed/" %}
    <iframe id="moonVideo" 
      src="{{ fixed_url }}?enablejsapi=1&controls=0&rel=0&showinfo=0" 
      frameborder="0" 
      allow="autoplay; encrypted-media" 
      allowfullscreen>
    </iframe>

    <!-- Custom Play Button Overlay -->
    <div class="custom-play-button">
        
      <img src="https://cdn.shopify.com/s/files/1/0549/2637/7049/files/play-circle-fill.png?v=1758277472" alt="Play Video">

    </div>
  </div>
</div>

  </div>
</section>

<style>
.moon-surface-right {
    margin-left: auto;
    width: 60%;
}
.moon-surface-right iframe {
    width: 70%;
    height: 100%;
}
.moon-surface-section {
  padding: 40px 0;
}
.moon-surface-left {
    width: 30%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 15px;
}
.moon-surface-left h2 {
    color: #3B4752;
    font-size: 84.1px;
    line-height: 78.1px;
    width: 478px;
    font-weight: 400;
    font-family: 'Berringer_Rough';
    margin-bottom: 0;
}
.moon-surface-left .subheading {
    font-size: 18px;
    line-height: 26.2px;
    font-weight: 700;
    margin-top: 0;
    padding-bottom: 0;
    margin-bottom: 0;
    color: #3B4752;
}
.moon-surface-left .newsletter-form {
  display: flex;
  gap: 10px;
  margin-top: 15px;
}
.moon-surface-left input[type="email"] {
    /* flex: 1; */
    height: 52px;
    padding-left: 20px !important;
    width: 413px;
    padding: 10px;
    height: 52px;
    border-radius: 43px;
    border: 1px solid #E7E7E7;
    font-size: 16.8px !important;
    line-height: 100%;
    color: #757575;
    font-family: 'Poligon_Regular';
}
.caption {
    color: #3B4752;
    font-family: 'Poligon_Regular';
    font-size: 16px;
    width: 550px;
    line-height: 25px;
}
.moon-surface-left input[type="email"]::placeholder {
    font-size: 16.8px !important;
    line-height: 100%;
    color: #757575;
    font-family: 'Poligon_Regular';
 
}
.moon-surface-left button {
    background: #3B4752;
    color: #fff;
    padding: 10px 20px;
    width: 413px;
    border-radius: 36px;
    border: none;
    cursor: pointer;
    border: 2px solid #3B4752;
    font-size: 14px;
    line-height: 24px;
    height: 52px !important;
    letter-spacing: 2px;
}
.moon-surface-left .button-note {
    line-height: 157%;
    font-size: 12px;
    width: 413px;
    color: #331A00;
    text-align: center;
    margin: 0;
    font-style: italic;
    font-weight: bold;
}
.video-wrapper {
  position: relative;
  padding-bottom: 56.25%; /* 16:9 ratio */
  height: 0;
}
.video-wrapper iframe,
.video-wrapper embed {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 12px;
}
.moon-surface-left .newsletter-form {
    max-width: 100%;
}
.faq-moon-surface .accordion__content {
    padding: 0 !important;
}

.custom-video {
  position: relative;
}
.custom-video iframe {
  width: 100%;
  height: 100%;
}
.custom-play-button {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  cursor: pointer;
  z-index: 2;
}
.custom-play-button img {
  width: 80px; /* apne hisab se size set karo */
  height: auto;
}
body button.ytp-large-play-button.ytp-button.ytp-large-play-button-red-bg {
    display: none;
}


</style>


<script>
document.addEventListener("DOMContentLoaded", function() {
  var playButton = document.querySelector(".custom-play-button");
  var iframe = document.getElementById("moonVideo");

  playButton.addEventListener("click", function() {
    playButton.style.display = "none";
    iframe.src += "&autoplay=1";
  });
});
</script>
