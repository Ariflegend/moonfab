{% if skip_anchor_modal %}
<script>
  (function () {
    var form = document.getElementById('add-to-cart-form');
    if (!form || form.dataset.b2bSparkBound === 'true') return;
    form.dataset.b2bSparkBound = 'true';

    form.addEventListener(
      'click',
      function (e) {
        var button = e.target.closest('.btn--add-to-cart');
        if (!button) return;

        e.preventDefault();
        e.stopImmediatePropagation();

        if (form.dataset.b2bAdding === 'true') return;
        form.dataset.b2bAdding = 'true';
        button.disabled = true;

        var formData = new FormData(form);
        formData.set('quantity', '1');

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData
        })
          .then(function (res) {
            return res.json().then(function (data) {
              if (!res.ok) throw data;
              return data;
            });
          })
          .then(function () {
            window.location.replace('/?spark-cart');
          })
          .catch(function (err) {
            console.error(err);
            form.dataset.b2bAdding = 'false';
            button.disabled = false;
          });
      },
      true
    );
  })();
</script>
{% endif %}
