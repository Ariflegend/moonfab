                  <div
                    id="spark-buy-after-description"
                    class="spark-buy-after-description"
                    data-spark-buy-slot
                    data-product-id="{{ product.id }}"
                  ></div>
                  <style>
                    .spark-buy-after-description {
                      margin: 0.75rem 0 1rem;
                      width: 100%;
                    }
                    .spark-buy-after-description spark-pdp {
                      display: block;
                      width: 100%;
                      /* Spark reads these through the shadow boundary */
                      --b2b-brand-color: #3B4752;
                      --b2b-brand-color-hover: #2a333b;
                      --spark-button-color: #3B4752;
                      --spark-button-color-highlight: #2a333b;
                      --spark-button-raised-background: #3B4752;
                      --spark-button-raised-background-hover: #2a333b;
                      --spark-button-raised-color: #ffffff;
                    }
                    /* Hide empty original Spark mount after the host is relocated */
                    [data-spark-buy-source-empty="true"] {
                      display: none !important;
                      min-height: 0 !important;
                      margin: 0 !important;
                      padding: 0 !important;
                    }
                  </style>
                  <script>
                    (function () {
                      if (window.__sparkBuyAfterDescriptionInit) return;
                      window.__sparkBuyAfterDescriptionInit = true;

                      var SLOT_ID = 'spark-buy-after-description';
                      var STYLE_ID = 'spark-buy-isolate-style';
                      var MARK = 'data-spark-buy-controls';
                      var HIDDEN = 'data-spark-buy-hidden';
                      var RELOCATED = 'data-spark-buy-relocated';
                      var SOURCE_EMPTY = 'data-spark-buy-source-empty';
                      var ATC_BG = '#3B4752';
                      var ATC_BG_HOVER = '#2a333b';
                      var ATC_TEXT = '#ffffff';
                      var shadowObserver = null;
                      var scheduled = false;
                      var processing = false;

                      function getSlot() {
                        return document.getElementById(SLOT_ID);
                      }

                      function ensureSparkPdp() {
                        var slot = getSlot();
                        var inSlot = slot && slot.querySelector('spark-pdp');
                        if (inSlot) return inSlot;

                        var existing = document.querySelector('spark-pdp');
                        if (existing) return existing;
                        if (!slot) return null;

                        var el = document.createElement('spark-pdp');
                        var productId = slot.getAttribute('data-product-id');
                        if (productId) el.setAttribute('parent-id', productId);
                        slot.appendChild(el);
                        return el;
                      }

                      function relocateSparkPdp(spark) {
                        var slot = getSlot();
                        if (!slot || !spark) return;

                        if (spark.parentElement && spark.parentElement !== slot) {
                          spark.parentElement.setAttribute(SOURCE_EMPTY, 'true');
                          slot.appendChild(spark);
                        }
                        spark.setAttribute(RELOCATED, 'true');

                        document.querySelectorAll('spark-pdp').forEach(function (el) {
                          if (el === spark) {
                            el.hidden = false;
                            el.removeAttribute('hidden');
                            el.removeAttribute('aria-hidden');
                            return;
                          }
                          el.hidden = true;
                          el.setAttribute('aria-hidden', 'true');
                        });
                      }

                      function findBuyControlsRoot(shadowRoot) {
                        if (!shadowRoot) return null;

                        var qty =
                          shadowRoot.querySelector('button[aria-label="Decrease quantity"]') ||
                          shadowRoot.querySelector('button[aria-label="Increase quantity"]') ||
                          shadowRoot.querySelector('input[aria-label="Quantity"]');
                        var atc =
                          shadowRoot.querySelector('button[aria-label^="Add to Cart"]') ||
                          shadowRoot.querySelector('button[aria-label^="Add to Order"]');
                        var list =
                          shadowRoot.querySelector('button[aria-label="Add to shopping list"]') ||
                          shadowRoot.querySelector('button[title="Add to shopping list"]');

                        if (!atc && !qty) return null;

                        var anchors = [qty, atc, list].filter(Boolean);
                        var node = anchors[0];

                        while (node && node !== shadowRoot) {
                          var containsAll = anchors.every(function (anchor) {
                            return node === anchor || node.contains(anchor);
                          });
                          if (containsAll) return node;
                          node = node.parentElement;
                        }

                        return atc ? atc.parentElement : null;
                      }

                      function ensureShadowStyle(shadowRoot) {
                        var style = shadowRoot.getElementById(STYLE_ID);
                        if (!style) {
                          style = document.createElement('style');
                          style.id = STYLE_ID;
                          shadowRoot.appendChild(style);
                        }
                        style.textContent = [
                          '[' + HIDDEN + '="true"] { display: none !important; }',
                          '[' + MARK + '="true"] { display: flex !important; }',
                          ':host {',
                          '  --b2b-brand-color: ' + ATC_BG + ';',
                          '  --b2b-brand-color-hover: ' + ATC_BG_HOVER + ';',
                          '  --spark-button-color: ' + ATC_BG + ';',
                          '  --spark-button-color-highlight: ' + ATC_BG_HOVER + ';',
                          '  --spark-button-raised-background: ' + ATC_BG + ';',
                          '  --spark-button-raised-background-hover: ' + ATC_BG_HOVER + ';',
                          '  --spark-button-raised-color: ' + ATC_TEXT + ';',
                          '}',
                          'button[aria-label^="Add to Cart"]:not(:disabled),',
                          'button[aria-label^="Add to Order"]:not(:disabled) {',
                          '  background-color: ' + ATC_BG + ' !important;',
                          '  background-image: none !important;',
                          '  color: ' + ATC_TEXT + ' !important;',
                          '}',
                          'button[aria-label^="Add to Cart"]:not(:disabled):hover,',
                          'button[aria-label^="Add to Order"]:not(:disabled):hover {',
                          '  background-color: ' + ATC_BG_HOVER + ' !important;',
                          '  color: ' + ATC_TEXT + ' !important;',
                          '}'
                        ].join('\n');
                      }

                      function isolateBuyControls(shadowRoot) {
                        if (!shadowRoot) return false;

                        var buyRoot = findBuyControlsRoot(shadowRoot);
                        if (!buyRoot) return false;

                        shadowRoot.querySelectorAll('[' + MARK + ']').forEach(function (el) {
                          el.removeAttribute(MARK);
                        });
                        shadowRoot.querySelectorAll('[' + HIDDEN + ']').forEach(function (el) {
                          el.removeAttribute(HIDDEN);
                        });

                        buyRoot.setAttribute(MARK, 'true');

                        var node = buyRoot;
                        while (node && node.parentNode) {
                          var parent = node.parentNode;
                          if (parent.nodeType !== 1 && parent !== shadowRoot) break;

                          Array.prototype.forEach.call(parent.children || [], function (child) {
                            if (child === node) return;
                            if (child.id === STYLE_ID) return;
                            child.setAttribute(HIDDEN, 'true');
                          });

                          if (parent === shadowRoot) break;
                          node = parent;
                        }

                        ensureShadowStyle(shadowRoot);
                        return true;
                      }

                      function observeShadow(shadowRoot) {
                        if (!shadowRoot) return;
                        if (shadowObserver) shadowObserver.disconnect();

                        shadowObserver = new MutationObserver(function () {
                          scheduleProcess();
                        });
                        shadowObserver.observe(shadowRoot, {
                          childList: true,
                          subtree: true
                        });
                      }

                      function process() {
                        if (processing) return;
                        processing = true;
                        try {
                          var spark = ensureSparkPdp();
                          if (!spark) return;

                          relocateSparkPdp(spark);

                          var shadowRoot = spark.shadowRoot;
                          if (!shadowRoot) return;

                          isolateBuyControls(shadowRoot);
                          observeShadow(shadowRoot);
                        } finally {
                          processing = false;
                        }
                      }

                      function scheduleProcess() {
                        if (processing || scheduled) return;
                        scheduled = true;
                        requestAnimationFrame(function () {
                          scheduled = false;
                          process();
                        });
                      }

                      function start() {
                        scheduleProcess();

                        var pageObserver = new MutationObserver(function () {
                          scheduleProcess();
                        });
                        pageObserver.observe(document.documentElement, {
                          childList: true,
                          subtree: true
                        });
                      }

                      if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', start);
                      } else {
                        start();
                      }
                    })();
                  </script>

