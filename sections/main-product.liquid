{%- liquid
assign current_variant = product.selected_or_first_available_variant
assign included_free = false
if product.metafields.my_fields.included_free == true
	assign included_free = true
endif
unless current_variant.price > 0
	assign included_free = true
endunless
assign addon_only = false
if product.metafields.my_fields.addon_only == true
	assign addon_only = true
endif
assign skip_anchor_modal = false
for tag in product.tags
	assign tag_down = tag | downcase
	if tag_down == 'b2b-only'
		assign skip_anchor_modal = true
	endif
endfor
assign hide_b2b_bundle_retail = false
if customer
	assign customer_has_b2b = false
	assign customer_has_b2b_bundle = false
	for tag in customer.tags
		assign tag_l = tag | downcase
		if tag_l == 'b2b'
			assign customer_has_b2b = true
		endif
		if tag_l == 'b2b-bundle-customers' or tag_l == 'b2b-bundles-customers'
			assign customer_has_b2b_bundle = true
		endif
	endfor
	if customer_has_b2b and customer_has_b2b_bundle
		assign hide_b2b_bundle_retail = true
	endif
endif
-%}
{% if hide_b2b_bundle_retail %}
