      <script>
        document.querySelectorAll('.popup-trigger').forEach(trigger => {
  trigger.addEventListener('click', (event) => {
    event.preventDefault();

    // Fetch data from data-* attributes
    const title = trigger.getAttribute('data-title');
    const description = trigger.getAttribute('data-description'); // Rich text HTML
    const image = trigger.getAttribute('data-image');
    const price = trigger.getAttribute('data-price');

    // Populate popup content
    popupTitle.textContent = title;
    popupImage.src = image;
    popupImage.alt = title;
    popupDescription.innerHTML = description; // Inject HTML safely
    popupPrice.textContent = price;

    // Show popup
    popup.classList.remove('hidden');
  });
});

      </script>
