<script>
document.addEventListener('DOMContentLoaded', () => {
  const popup = document.getElementById('popup');
  const popupTitle = document.getElementById('popup-title');
  const popupImage = document.getElementById('popup-image');
  const popupDescription = document.getElementById('popup-description');
  const popupPrice = document.getElementById('popup-price');
  const closePopup = document.querySelector('.close-popup');

  // Open popup on clicking the trigger
  document.querySelectorAll('.popup-trigger').forEach(trigger => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();

      // Fetch data from data-* attributes
      const title = trigger.getAttribute('data-title');
      const description = trigger.getAttribute('data-description'); // Rich text HTML
      const image = trigger.getAttribute('data-image');
      const price = trigger.getAttribute('data-price');

      // Populate popup content
      popupTitle.textContent = title;
      popupImage.src = image;
      popupImage.alt = title;
      popupDescription.innerHTML = description; // Inject HTML safely
      popupPrice.textContent = price;

      // Show popup
      popup.classList.remove('hidden');
    });
  });

  // Close popup on clicking the close button
  closePopup.addEventListener('click', () => {
    popup.classList.add('hidden');
  });

  // Close popup on clicking outside the content
  popup.addEventListener('click', (event) => {
    if (event.target === popup) {
      popup.classList.add('hidden');
    }
  });
});

</script>

