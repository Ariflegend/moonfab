{%- liquid
assign product_images = product.media | where: "media_type", "image"
assign uploaded_videos = product.media | where: "media_type", "video"
assign external_videos = product.media | where: "media_type", "external_video"
assign all_videos = uploaded_videos | concat: external_videos
assign is_anchor = false
for collection in product.collections
	if collection.handle == 'moonanchors'
		assign is_anchor = true
		assign primary_collection = collection
	endif
	if collection.handle == 'apparel'
		assign primary_collection = collection
	endif
	if collection.handle == 'moonwall'
		assign primary_collection = collection
	endif
endfor
-%}
{%- liquid
	assign current_variant = product.selected_or_first_available_variant
	assign price = current_variant.price
	assign product_images = product.media | where: "media_type", "image"
	assign uploaded_videos = product.media | where: "media_type", "video"
	assign external_videos = product.media | where: "media_type", "external_video"
	assign all_videos = uploaded_videos | concat: external_videos
	assign thumbnails = ''

	assign backorder = false
	if product.selected_or_first_available_variant.inventory_policy == 'continue' and product.selected_or_first_available_variant.inventory_quantity == 0
		assign backorder = true
	endif

	if product.metafields.caliber.addon_product_data
		assign addon_product_data = product.metafields.caliber.addon_product_data
	else
		assign addon_product_data = nil
	endif


	for variant in product.variants
		if variant.available
			if variant.inventory_quantity > 0
				assign in_stock = true
			else
				assign in_stock = false
			endif
		else
			assign in_stock = false
		endif	
		break
	endfor

	assign featured_image = product.featured_image | img_url: '1200x'
	assign featured_image_ratio = product.featured_image.aspect_ratio

-%}

