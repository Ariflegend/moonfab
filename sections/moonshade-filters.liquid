</style>

<script>
document.addEventListener('DOMContentLoaded',()=>{

    const rows=[...document.querySelectorAll('.fitment-table tbody tr')];
    console.log('Total fitment entries loaded:', rows.length);

    const search=document.getElementById('fitment-search');
    const count=document.getElementById('fitment-count');

    let category='';
    let product='';

    function isCategoryMatch(rowCategory, filterCategory) {
        if (!filterCategory) return true;
        
        const rowVal = (rowCategory || '').trim().toLowerCase();
        const filterVal = (filterCategory || '').trim().toLowerCase();
        
        if (rowVal === filterVal) return true;
        
        const mappings = {
            'van': ['van', 'vans'],
            'truck': ['truck', 'trucks'],
            'suv': ['suv', 'suvs', 'suvs & crossovers', 'suvs and crossovers'],
            'motorhome': ['motorhome', 'motorhomes'],
            'trailer': ['trailer', 'trailers'],
            'truck camper': ['truck camper', 'truck campers']
        };
        
        const equivalents = mappings[filterVal];
        if (equivalents) {
            return equivalents.includes(rowVal);
        }
        
        return rowVal.includes(filterVal);
    }

    function filterRows(){

        const text=search.value.toLowerCase();
        let visible=0;

        rows.forEach(row=>{

            const matchCategory=isCategoryMatch(row.dataset.category, category);
            const matchProduct=!product || (row.dataset.product || '').trim().toLowerCase()===product.trim().toLowerCase();
            const matchSearch=row.dataset.search.toLowerCase().includes(text);

            const show=matchCategory && matchProduct && matchSearch;

            row.style.display=show ? '' : 'none';

            if(show) visible++;

        });

        count.textContent=`SHOWING ${visible} OF ${rows.length} VEHICLES`;
        console.log(`Filtered fitment entries: ${visible} showing out of ${rows.length} total`);
    }

    search.addEventListener('input',filterRows);

    // Mobile modal
    const modal = document.querySelector('.fitment-filter-modal');
    document.querySelector('.js-open-filter').addEventListener('click', () => modal.classList.add('open'));
    document.querySelector('.js-close-filter').addEventListener('click', () => modal.classList.remove('open'));
    modal.addEventListener('click', e => { if(e.target === modal) modal.classList.remove('open'); });

    document.querySelectorAll('.js-accordion-toggle').forEach(toggle => {
        toggle.addEventListener('click', () => {
            toggle.classList.toggle('open');
            toggle.nextElementSibling.classList.toggle('open');
        });
    });

    document.querySelectorAll('input[name="mobile-category"]').forEach(radio => {
        radio.addEventListener('change', () => { category = radio.value; });
    });
    document.querySelectorAll('input[name="mobile-product"]').forEach(radio => {
        radio.addEventListener('change', () => { product = radio.value; });
    });

    document.querySelector('.js-apply-filters').addEventListener('click', () => {
        filterRows();
        modal.classList.remove('open');
        // sync desktop buttons
        document.querySelectorAll('[data-category]').forEach(b => b.classList.toggle('active', b.dataset.category === category));
        document.querySelectorAll('[data-product]').forEach(b => b.classList.toggle('active', b.dataset.product === product));
    });

    document.querySelectorAll('[data-category]').forEach(btn=>{

        btn.addEventListener('click',()=>{

            document.querySelectorAll('[data-category]').forEach(b=>b.classList.remove('active'));

            btn.classList.add('active');

            category=btn.dataset.category;

            filterRows();

        });

    });

    document.querySelectorAll('[data-product]').forEach(btn=>{

        btn.addEventListener('click',()=>{

            document.querySelectorAll('[data-product]').forEach(b=>b.classList.remove('active'));

            btn.classList.add('active');

            product=btn.dataset.product;

            filterRows();

        });

    });

    const colorMap = {
  "MoonShade": {
    bg: "#FFF3E0",
    border: "#B8D9B9",
    text: "#3D6B3E"
  },
  "MoonShade XL": {
    bg: "#FDF5EE",
    border: "#F0C49A",
    text: "#8A4A1A"
  },
  "MoonShade RV": {
    bg: "#FFF3E0",
    border: "#F5D08A",
    text: "#8A5A00"
  },
  "MoonShade Apex": {
    bg: "#FDF5EE",
    border: "#DBB8E8",
    text: "#7A3A8A"
  },
  "MoonShade Pro": {
    bg: "#FDF5EE",
    border: "#B8BAF5",
    text: "#3A3AA0"
  }
};

document.querySelectorAll(".fitment-table td span").forEach(span => {
  const product = span.textContent.trim();
  const colors = colorMap[product];

  if (!colors) return;

  span.style.backgroundColor = colors.bg;
  span.style.border = `1px solid ${colors.border}`;
  span.style.color = colors.text;
});
const sortBtn = document.querySelector(".js-sort-make");
const tbody = document.querySelector(".fitment-table tbody");

sortBtn.addEventListener("click", () => {

    const rows = [...tbody.querySelectorAll("tr")];

    const isAsc = sortBtn.dataset.direction === "asc";

    rows.sort((a, b) => {

        const makeA = a.children[1].textContent.trim().toLowerCase();
        const makeB = b.children[1].textContent.trim().toLowerCase();

        return isAsc
            ? makeA.localeCompare(makeB)
            : makeB.localeCompare(makeA);

    });

    rows.forEach(row => tbody.appendChild(row));

    sortBtn.dataset.direction = isAsc ? "desc" : "asc";

    sortBtn.classList.toggle("desc", isAsc);

});

    // Custom scrollbar sync on mobile
    const tableWrapper = document.querySelector('.fitment-table-wrapper');
    const scrollTrack = document.querySelector('.fitment-custom-scrollbar');
    const scrollThumb = document.querySelector('.fitment-custom-scrollbar__thumb');

    function updateScrollThumb() {
        if (!tableWrapper || !scrollThumb) return;
        const scrollRatio = tableWrapper.scrollLeft / (tableWrapper.scrollWidth - tableWrapper.clientWidth);
        const thumbMaxLeft = (scrollTrack.clientWidth - scrollThumb.offsetWidth);
        scrollThumb.style.left = (scrollRatio * thumbMaxLeft) + 'px';
    }

    if (tableWrapper && scrollTrack && scrollThumb) {
        tableWrapper.addEventListener('scroll', updateScrollThumb);

        // Drag to scroll logic
        let isDragging = false;
        let startX = 0;
        let startScrollLeft = 0;

        scrollThumb.addEventListener('mousedown', (e) => {
            isDragging = true;
            startX = e.clientX;
            startScrollLeft = tableWrapper.scrollLeft;
            document.body.style.userSelect = 'none';
        });
        scrollTrack.addEventListener('mousedown', (e) => {
            if (e.target === scrollTrack) {
                const clickRatio = e.offsetX / scrollTrack.clientWidth;
                tableWrapper.scrollLeft = clickRatio * (tableWrapper.scrollWidth - tableWrapper.clientWidth);
                updateScrollThumb();
            }
        });
        document.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            const dx = e.clientX - startX;
            const trackRatio = dx / (scrollTrack.clientWidth - scrollThumb.offsetWidth);
            tableWrapper.scrollLeft = startScrollLeft + trackRatio * (tableWrapper.scrollWidth - tableWrapper.clientWidth);
        });
        document.addEventListener('mouseup', () => {
            isDragging = false;
            document.body.style.userSelect = '';
        });

        // Touch drag support
        let touchStartX = 0;
        let touchStartScrollLeft = 0;
        scrollThumb.addEventListener('touchstart', (e) => {
            touchStartX = e.touches[0].clientX;
            touchStartScrollLeft = tableWrapper.scrollLeft;
        }, { passive: true });
        scrollThumb.addEventListener('touchmove', (e) => {
            const dx = e.touches[0].clientX - touchStartX;
            const trackRatio = dx / (scrollTrack.clientWidth - scrollThumb.offsetWidth);
            tableWrapper.scrollLeft = touchStartScrollLeft + trackRatio * (tableWrapper.scrollWidth - tableWrapper.clientWidth);
        }, { passive: true });

        // Set initial thumb width relative to visible vs total scroll width
        function setThumbWidth() {
            const ratio = tableWrapper.clientWidth / tableWrapper.scrollWidth;
            scrollThumb.style.width = Math.max(ratio * 100, 15) + '%';
        }
        setThumbWidth();
        window.addEventListener('resize', () => { setThumbWidth(); updateScrollThumb(); });
    }

});
</script>

