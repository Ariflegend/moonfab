{% paginate shop.metaobjects.moonshade_fitment.values by 250 %}
{% assign fitments = shop.metaobjects.moonshade_fitment.values %}

<link href="https://fonts.cdnfonts.com/css/poligon?styles=84984" rel="stylesheet">
<section class="fitment-guide">
    <div class="fitment-filter-modal">
    <div class="fitment-filter-modal__content">
        <div class="fitment-filter-modal__header">
            <span>Filters</span>
            <button class="js-close-filter">&times;</button>
        </div>

        <div class="mobile-filter-accordion">
            <button class="mobile-accordion-toggle js-accordion-toggle">BY TYPE <span class="accordion-arrow">&#9660;</span></button>
            <div class="mobile-accordion-body">
                <label class="mobile-radio-option">
                    <input type="radio" name="mobile-category" value="" checked> All vehicles
                </label>
                {% assign vehicle_options = "Vans:VAN|Trucks:TRUCK|SUVs & Crossovers:SUV|Motorhomes:MOTORHOME|Trailers:TRAILER|Truck Campers:TRUCK CAMPER" | split: "|" %}
                {% for option in vehicle_options %}
                    {% assign parts = option | split: ":" %}
                    <label class="mobile-radio-option">
                        <input type="radio" name="mobile-category" value="{{ parts[1] }}"> {{ parts[0] }}
                    </label>
                {% endfor %}
            </div>
        </div>

        <div class="mobile-filter-accordion">
            <button class="mobile-accordion-toggle js-accordion-toggle">BY PRODUCT <span class="accordion-arrow">&#9660;</span></button>
            <div class="mobile-accordion-body">
                <label class="mobile-radio-option">
                    <input type="radio" name="mobile-product" value="" checked> All products
                </label>
                {% assign product_options = "OG:MoonShade|XL:MoonShade XL|Pro:MoonShade Pro|Apex:MoonShade Apex|RV:MoonShade RV" | split: "|" %}
                {% for option in product_options %}
                    {% assign parts = option | split: ":" %}
                    <label class="mobile-radio-option">
                        <input type="radio" name="mobile-product" value="{{ parts[1] }}"> {{ parts[0] }}
                    </label>
                {% endfor %}
            </div>
        </div>

        <button class="js-apply-filters">Apply Filters</button>
    </div>
    </div>
    <div class="fitment-filters">
        {% assign menu_icon = '<svg width="33" height="27" viewBox="0 0 36 30" fill="black"><path d="M1.5 1.5H34.5M1.5 15H34.5M1.5 28.5H34.5" stroke="#C2C2C2" stroke-width="3" stroke-linecap="round"/></svg>' %}
        <div class="fitment-search-wrapper">
            <div class="js-open-filter">
                {{ menu_icon }}
            </div>
            <div class="search-wrapper">
            {% assign search_icon = '<svg width="19" height="20" viewBox="0 0 19 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14.7097 14.7384L17.9848 18.0135M16.9502 8.97509C16.9502 11.0902 16.1099 13.1187 14.6143 14.6143C13.1187 16.1099 11.0902 16.9502 8.97509 16.9502C6.85996 16.9502 4.83147 16.1099 3.33585 14.6143C1.84023 13.1187 1 11.0902 1 8.97509C1 6.85996 1.84023 4.83147 3.33585 3.33585C4.83147 1.84023 6.85996 1 8.97509 1C11.0902 1 13.1187 1.84023 14.6143 3.33585C16.1099 4.83147 16.9502 6.85996 16.9502 8.97509Z" stroke="black" stroke-opacity="0.24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' %}
             {{ search_icon }}
            <input
                type="text"
                id="fitment-search"
                placeholder="Search make, model, or category..."
            >
        </div>
    </div>

    <div class="filter-group vehicle-filter">
      <strong>BY TYPE</strong>

      <button class="active" data-category="">All vehicles</button>
        {% assign vehicle_options = "Vans:VAN|Trucks:TRUCK|SUVs & Crossovers:SUV|Motorhomes:MOTORHOME|Trailers:TRAILER|Truck Campers:TRUCK CAMPER" | split: "|" %}

        {% for option in vehicle_options %}
            {% assign parts = option | split: ":" %}

            <button data-category="{{ parts[1] }}">
            {{ parts[0] }}
            </button>
        {% endfor %}
     
    </div>

    <div class="filter-group product-filter">
      <strong>BY PRODUCT</strong>

      <button class="active" data-product="">All products</button>

        {% assign product_options = "OG:MoonShade|XL:MoonShade XL|Pro:MoonShade Pro|Apex:MoonShade Apex|RV:MoonShade RV" | split: "|" %}

        {% for option in product_options %}
            {% assign parts = option | split: ":" %}

            <button data-product="{{ parts[1] }}">
            {{ parts[0] }}
            </button>
        {% endfor %}
    </div>

    <p id="fitment-count">
      SHOWING {{ fitments.count }} OF {{ fitments.count }} VEHICLES
    </p>

  </div>
  {%  assign sort_arrow = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 19V5M12 5L6 11M12 5L18 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' %}
  <div class="fitment-custom-scrollbar">
    <div class="fitment-custom-scrollbar__thumb"></div>
  </div>
  <div class="fitment-table-wrapper">
    <table class="fitment-table">
        <thead>
        <tr>
            <th><span>Category</span></th>
            <th><span class="js-sort-make" data-direction="asc">Make{{ sort_arrow }}</span></th>
            <th><span>Model</span></th>
            <th><span>MoonShade</span></th>
            <th><span>Mounting</span></th>
        </tr>
        </thead>

        <tbody>

        {% for item in fitments %}
        {%- # <spark:avge3> -%}
          {%- capture visibility -%}
            {%- render 'sparklayer-b2b-catalogs-func', type:'search.item', subject:item -%}
          {%- endcapture -%}
          {%- if visibility == 'hide' -%}
            {%- continue -%}
          {%- endif -%}
        {%- # </spark:avge3> -%}
        

            <tr
            data-category="{{ item.category.value }}"
            data-product="{{ item.moonshade.value }}"
            data-search="{{ item.category.value }} {{ item.make.value }} {{ item.model.value }} {{ item.moonshade.value }}"
            >
            <td>{{ item.category }}</td>
            <td>{{ item.make }}</td>
            <td>{{ item.model }}</td>
            <td><span>{{ item.moonshade }}</span></td>
            <td>{{ item.mounting }}</td>
            </tr>

        {% endfor %}

        </tbody>
    </table>
  </div>

</section>
{% endpaginate %}

<style>
