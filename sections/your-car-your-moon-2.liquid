<link
  rel="stylesheet"
  href="https://unpkg.com/swiper/swiper-bundle.min.css"
>
<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>



<style>
    .ycym-section {
  width: 100%;
  overflow: hidden;
  padding: 0px 0px 30px 0px;
}
    
.ycym-container {
max-width: 94%;
  margin: 0 auto;
}

.ycym-heading.related-collection-heading.custom-swiper-heading {
    margin: 30px 0px 20px 0px !important;
    font-family: Berringer_Rough !important;
    font-weight: 400;
    font-style: Regular;
    font-size: 26px;
    line-height: 33px;
    letter-spacing: 0px;
    font-size: 21px;
    line-height: 26px;
    color: #3b4752 !important;
  }



.ycym-swiper {
    width: calc(100% + 20px);
     overflow: hidden;
     padding-right: 20px;
}
.ycym-section .ycym-swiper .swiper-wrapper {
  justify-content: flex-start !important;
}

.ycym-slide {
  height: auto;
}

.ycym-card-link {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: inherit;
}

.ycym-card-image-wrap {
  margin-bottom: 14px;
  overflow: hidden;
  border-radius: 7.33px;
}

.ycym-card-image {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 7.33px;
}

.ycym-card-title {
  margin: 0 0 9.99px;
  padding: 7px;
  border-radius: 32.16px;
  background-color: #fbf5e7;
  color: #3b4752;
  text-align: center;
  font-family: Poligon, Poligon_Semi_Bold, sans-serif;
  font-weight: 500;
  font-size: 16.67px;
  line-height: 23.57px;
  letter-spacing: 0.44px;
}

.ycym-card-subtext {
  margin: 0;
  color: #3b4752;
  text-align: center;
  font-family: Poligon_Regular, Poligon, sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 16.81px;
  letter-spacing: 0.44px;
}

.ycym-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-top: 30px;
}

.ycym-nav-btn {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  padding: 0;
  border: none;
  background: transparent;
  cursor: pointer;
}

.ycym-nav-btn svg {
  display: block;
  width: 44px;
  height: 44px;
}

.ycym-nav-btn.swiper-button-disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.ycym-swiper-pagination {
  position: relative !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: auto !important;
  bottom: auto !important;
  left: auto !important;
}

.ycym-section .ycym-swiper-pagination.swiper-pagination-clickable.swiper-pagination-bullets.swiper-pagination-horizontal {
  display: flex !important;
}

.ycym-section .ycym-swiper-pagination .swiper-pagination-bullet {
  width: 8px;
  height: 8px;
  margin: 0 !important;
  opacity: 1;
  background-color: #d3d3d3;
}

.ycym-section .ycym-swiper-pagination .swiper-pagination-bullet-active {
  background-color: #a8a8a8;
}

@media (min-width: 769px) {
  .ycym-container {
    padding: 0 40px;
  }
.ycym-swiper {
  width: 100%;
}
  .ycym-heading {
    margin-bottom: 30px;
  }

  .ycym-card-image-wrap {
    margin-bottom: 20px;
    border-radius: 11px;
  }

      .ycym-heading.related-collection-heading.custom-swiper-heading {
    margin: 50px 0px 30px 0px !important;
    font-family: Berringer_Rough !important;
    font-weight: 400;
    font-style: Regular;
    font-size: 26px;
    line-height: 33px;
    letter-spacing: 0px;
    font-size: 21px;
    line-height: 26px;
    color: #3b4752 !important;
  }

  .ycym-card-image {
    border-radius: 11px;
  }

  .ycym-card-title {
    margin-bottom: 15px;
    padding: 10px;
    border-radius: 48.27px;
    font-size: 23px;
    line-height: 35.37px;
    letter-spacing: 0.66px;
  }

  .ycym-card-subtext {
    font-size: 17.22px;
    line-height: 25.23px;
    letter-spacing: 0.66px;
  }

  .ycym-controls {
    margin-top: 40px;
  }
}

    </style>
<section class="ycym-section ycym-section-v2" id="ycym-{{ section.id }}">
  <div class="ycym-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="ycym-heading related-collection-heading custom-swiper-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="swiper-container ycym-swiper" id="ycymSwiper-{{ section.id }}">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide ycym-slide" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="ycym-card-link">
            {%- else -%}
              <div class="ycym-card-link">
            {%- endif -%}

            {%- if block.settings.image != blank -%}
              <div class="ycym-card-image-wrap">
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    class: 'ycym-card-image',
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    sizes: '(min-width: 769px) 25vw, 60vw',
                    alt: block.settings.image.alt | default: block.settings.title
                }}
              </div>
            {%- else -%}
              <div class="ycym-card-image-wrap">
                {{ 'image' | placeholder_svg_tag: 'ycym-card-image' }}
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <p class="ycym-card-title">{{ block.settings.title }}</p>
            {%- endif -%}

            {%- if block.settings.subtext != blank -%}
              <p class="ycym-card-subtext">{{ block.settings.subtext }}</p>
            {%- endif -%}

            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var sectionId = 'ycym-{{ section.id }}';

    function initYcymSwiper() {
      var root = document.getElementById(sectionId);
      if (!root || typeof Swiper === 'undefined') return;

      var swiperEl = root.querySelector('#ycymSwiper-{{ section.id }}');
      if (!swiperEl) return;

      if (swiperEl.swiper) {
        swiperEl.swiper.destroy(true, true);
      }

      new Swiper(swiperEl, {
        slidesPerView: 1.7,
        spaceBetween: 16,
              autoplay: {
          delay: 5000,
          disableOnInteraction: false,
        },
        navigation: {
          nextEl: root.querySelector('.ycym-nav-next'),
          prevEl: root.querySelector('.ycym-nav-prev'),
        },
        pagination: {
          el: root.querySelector('.ycym-swiper-pagination'),
          clickable: true,
        },
        breakpoints: {
          769: {
            slidesPerView: 4,
            spaceBetween: 20,
          },
        },
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initYcymSwiper);
    } else {
      initYcymSwiper();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.target.querySelector('#' + sectionId)) {
        initYcymSwiper();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Your car. Your Moon",
  "tag": "section",
  "class": "section-ycym",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your car. Your Moon"
    }
  ],
  "blocks": [
    {
      "type": "setup_card",
      "name": "Setup card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Vehicle title",
          "default": "TOYOTA 4 RUNNER"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Mike & Twylla's Setup"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Your car. Your Moon 2",
      "blocks": [
        {
          "type": "setup_card",
          "settings": {
            "title": "TOYOTA 4 RUNNER",
            "subtext": "Mike & Twylla's Setup"
          }
        },
        {
          "type": "setup_card",
          "settings": {
            "title": "FORD TRANSIT",
            "subtext": "Mike & Twylla's Setup"
          }
        },
        {
          "type": "setup_card",
          "settings": {
            "title": "RAM PROMASTER",
            "subtext": "Mike & Twylla's Setup"
          }
        },
        {
          "type": "setup_card",
          "settings": {
            "title": "JEEP WRANGLER",
            "subtext": "Mike & Twylla's Setup"
          }
        }
      ]
    }
  ]
}
{% endschema %}
