<style>
  #shopify-section-{{ section.id }} .about-moon {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .about-moon__wrapper {
    max-width: 1020px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .about-moon__layout {
    display: grid;
    grid-template-columns: {{ section.settings.image_width }}% 1fr;
    gap: {{ section.settings.column_gap }}px;
        align-items: start;

  }

  #shopify-section-{{ section.id }} .about-moon__image-wrap img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ section.settings.image_radius }}px;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .about-moon__image-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: rgba(var(--color-foreground, 0,0,0), 0.06);
    border-radius: {{ section.settings.image_radius }}px;
  }

  #shopify-section-{{ section.id }} .about-moon__heading {
    font-family: 'Berringer_Rough', sans-serif;
    font-size: {{ section.settings.heading_size }}px;
    line-height: {{ section.settings.heading_line_height }};
    font-weight: 400 !important;
    letter-spacing: 0px;
    text-transform: uppercase;
    margin: 0 0 1.25rem 0;
  }

  #shopify-section-{{ section.id }} .about-moon__paragraph {
    font-family: 'Poligon_Regular', sans-serif;
    font-size: {{ section.settings.body_size }}px;
    line-height: {{ section.settings.body_line_height }};
    color: rgba(var(--color-foreground, 0,0,0), 0.85);
    margin: 0 0 1.25rem 0;
    max-width: 373px;
    letter-spacing: 0px;
  }

  #shopify-section-{{ section.id }} .about-moon__paragraph:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .about-moon__paragraph strong,
  #shopify-section-{{ section.id }} .about-moon__paragraph b {
    font-family: 'Poligon_Bold', sans-serif;
    font-weight: 700;
    color: rgba(var(--color-foreground, 0,0,0), 1);
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .about-moon__layout {
      grid-template-columns: 1fr;
    }
    .about-moon__content .about-moon__heading {
    font-size: 16px !important;
  }
  .about-moon__content .about-moon__paragraph{
  font-size:13px !important;
}
  }
</style>

<div class="about-moon color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="about-moon__wrapper page-width">
    <div class="about-moon__layout">

      <div class="about-moon__image-wrap">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200' }}
        {% else %}
          <div class="about-moon__image-placeholder"></div>
        {% endif %}
      </div>

      <div class="about-moon__content">
        {% if section.settings.heading != blank %}
          <h2 class="about-moon__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% for block in section.blocks %}
          {% if block.type == 'paragraph' %}
            <div class="about-moon__paragraph" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "About text with image",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image column width",
      "min": 25,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between image and text",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Moon"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading line height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "header",
      "content": "Body text"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "body_line_height",
      "label": "Body text line height",
      "min": 0.8,
      "max": 2.5,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "info": "Select text and use the Bold option to bold a lead-in phrase, like in the reference design.",
          "default": "<p><strong>Moon is a certified carbon-neutral company,</strong> and has been featured in renowned publications like Outside and Gear Junkie over the years.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About text with image",
      "blocks": [
        {
          "type": "paragraph",
          "settings": {
            "text": "<p><strong>Moon is a certified carbon-neutral company,</strong> and has been featured in renowned publications like Outside and Gear Junkie over the years. The community is made up of 20,000+ members including van lifers, RVers, overlanders, and weekend campers across the country.</p>"
          }
        },
        {
          "type": "paragraph",
          "settings": {
            "text": "<p><strong>MoonShade has been tested in every condition</strong> — desert sun, mountain wind, Pacific Northwest rain — and refined based on real feedback from real rigs. The design principle hasn't changed since day one: Designed to go anywhere. Built to stay there.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}