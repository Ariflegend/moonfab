  padding: 12px 20px;
  background-color: #2c3640;
  color: white;
  text-decoration: none;
  border-radius: 999px;
  font-weight: 600;
  font-family: sans-serif;
  font-size: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: background 0.3s ease;
} */

.cta-buttons a:hover {
  background-color: #3b4a57;
}

.cta-buttons a .icon {
  display: inline-block;
  font-size: 12px;
}
    @media only screen and (min-width: 760px) and (max-width: 860px) {
  .banner-container {
    padding: 0px! important;
  }
}

@media (max-width: 749px) {
    body .banner-versatile-awning .banner__box>*+.banner__buttons {
        margin-top: 17rem !important;
    }
  .banner-container {
    height: auto;
}
  
.banner__box.content-container.content-container--full-width-mobile.color-scheme-3.gradient {
    display: flex;
    flex-direction: column;
}
.banner__buttons {
    order: 2;
}
.review-box {
    order: 2;
}
  .cta-buttons a {
    padding: 12px !important;
   font-size: 9.39px;
}
  .cta-box h2 {
    font-size: 20px;
    margin-top: -31px;
    margin-bottom: 0;
    font-weight: 400;
}
  .cta-buttons {
  flex-wrap: unset !important;
}
.cta-buttons a {
    width: 100% ! IMPORTANT;
    text-align: center;
    justify-content: center;
}

.cta-box {
  width: 100%;
}

.cta-buttons a:first-child {
    padding: 10px;
}
.banner-container {
    width: 100%;
