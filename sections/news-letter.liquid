

<div class="news-letter-page">
  <img src="{{ section.settings.image-pick | image_url}}"  class="News" alt="News Letter">
      <input type="hidden" name="contact[tags]" value="newsletter">
  <p class="moon-des-newsletter">{{ section.settings.news-letter-text }}</p>


  
{% form 'contact', class: '' %}

    {%- if form.posted_successfully? -%}
      <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
        {{ 'general.newsletter.success' | t }}
      </h2>
      <p class="success-message">Thank you! Your message has been sent successfully.</p>

    {%- elsif form.errors -%}
      <div class="form__message">
        <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
         
        </h2>
      </div>
    {%- endif -%}

    <div class="newsletter__fields">
      <h4 class="lbl-text">Name</h4>
      <div class="first-and-last">
          <div class="field">
            <input class="field__input" type="text" id="NewsletterForm-firstname" name="customer[first_name]" placeholder="First Name" required>
            <label class="field__label" for="NewsletterForm-firstname">First</label>
          </div>
      
          <div class="field">
            <input class="field__input" type="text" id="NewsletterForm-lastname" name="customer[last_name]" placeholder="Last Name" required>
            <label class="field__label" for="NewsletterForm-lastname">Last</label>
          </div>
      </div>
      <h4 class="lbl-text">Email</h4>
      <div class="email-field">
          <div class="field field--with-error">
            <input class="field__input" type="email" id="NewsletterForm-email" name="customer[email]" placeholder="Email Address" required>
            <label class="field__label" for="NewsletterForm-email">your@email.com</label>
          </div>
      </div>
    </div>

    <div class="newsletter__button">
      <button type="submit" class="button" name="commit" id="Subscribe">Sign Me Up!</button>
    </div>

    <!-- Hidden Inputs -->
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="hidden" name="customer[accepts_marketing]" value="true"> 
    <input type="hidden" name="return_to" value="/pages/thank-you"> <!-- Change this to your thank you page -->
    
{%- endform -%}

  <p>{{ section.settings.text_last }}</p>
</div>


{% schema %}
{
  "name": "News-letter",
  "settings": [
    {
      "type": "text",
      "id": "form_title",
      "label": "Form Title"
    },
    {
      "type": "text",
      "id": "submit_button_text",
      "label": "Button Text"
    },
    {
      "type":"image_picker",
      "id":"image-pick",
      "label":"Newsletter Image"
    },
  
       {
  "type": "richtext",
  "id": "news-letter-text",
  "label": "Newsletter Text",
},
   {
  "type": "richtext",
  "id": "text_last",
  "label": "Newsletter Description",
}

    
  ],
  "blocks": [
    {
      "type": "text_field",
      "name": "Text Field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Field Label"
        }
      ]
    },
    {
      "type": "email_field",
      "name": "Email Field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Field Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "news-letter",
      "category": "Custom"
    }
  ]
}
{% endschema %}
