      "type": "product",
      "id": "product_1",
      "label": "Select First Product"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Select Second Product"
    }
   
  ],"blocks": [
   
  ],
  "presets": [
    {
      "name": "moonwall quiz",
      "category": "Custom"
    }
  ]
}
{% endschema %}